# Copy to .env (git-ignored) and fill in. Read by scripts/release-local.py for --deploy.
# Optional: `npx wrangler login` (browser sign-in) works instead, with nothing stored here.
# Make a token at Cloudflare > My Profile > API Tokens ("Edit Cloudflare Workers" template).
# The Account ID is on the Workers & Pages overview page. Never commit .env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
