// Cloudflare deployment of the built site, used by scripts/release-local.py --deploy
// (`npx --yes wrangler deploy`). Static assets only: no Worker code runs, and asset
// requests are free on the Workers plan. `_site/` is assembled from dist/ by the script.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usb-tool",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
  // Second step, once the first deploy is live and GitHub Pages is switched off: attach
  // the domain by uncommenting this and deploying again (wrangler creates the DNS record).
  // "routes": [{ "pattern": "usb.olosnoks.com", "custom_domain": true }]
}
